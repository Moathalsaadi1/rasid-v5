# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=rasid
POSTGRES_PASSWORD=rasid_secret
POSTGRES_DB=rasid
DATABASE_URL=postgresql://rasid:rasid_secret@db:5432/rasid

# ─── Redis (Celery broker & result backend) ───────────────────────────────
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ─── Docker-in-Docker ─────────────────────────────────────────────────────
DOCKER_HOST=tcp://docker:2375

# ─── Tool images (override per-tool to pin versions) ──────────────────────
TOOL_NMAP_IMAGE=instrumentisto/nmap:latest
TOOL_HTTPX_IMAGE=projectdiscovery/httpx:latest
TOOL_NUCLEI_IMAGE=projectdiscovery/nuclei:latest
TOOL_SUBFINDER_IMAGE=projectdiscovery/subfinder:latest
TOOL_AMASS_IMAGE=caffix/amass:latest
TOOL_MASSCAN_IMAGE=ilyaglow/masscan:latest
TOOL_MASSDNS_IMAGE=rasid/massdns:latest

# ─── Application ──────────────────────────────────────────────────────────
# Allow scans against private/loopback IPs (DANGEROUS — lab use only).
# When false, RFC1918, 127/8, link-local and metadata IPs are blocked.
ALLOW_PRIVATE_TARGETS=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated origins allowed by CORS (dev defaults if unset).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────────────────
# In-memory works for single-process dev. For multi-worker deploys point
# this at Redis (e.g. redis://redis:6379/2).
RATE_LIMIT_STORAGE_URI=memory://
